<Window x:Class="HappAccessible.SubscriptionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сведения о подписке"
        Height="500" Width="620"
        MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.Name="Подробные сведения о подписке">
    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom"
                Content="Закрыть (_C)"
                IsCancel="True"
                IsDefault="True"
                HorizontalAlignment="Right"
                MinWidth="110"
                MinHeight="32"
                Margin="0,16,0,0"
                Click="CloseButton_OnClick"
                AutomationProperties.Name="Закрыть сведения о подписке" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />
                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Источник:" Margin="0,4,8,4" />
                    <TextBlock x:Name="SourceText" Grid.Row="0" Grid.Column="1"
                               TextWrapping="Wrap" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Серверов:" Margin="0,4,8,4" />
                    <TextBlock x:Name="ServersText" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Трафик использован:" Margin="0,4,8,4" />
                    <TextBlock x:Name="UsedText" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Осталось трафика:" Margin="0,4,8,4" />
                    <TextBlock x:Name="RemainingText" Grid.Row="3" Grid.Column="1" Margin="0,4" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Окончание:" Margin="0,4,8,4" />
                    <TextBlock x:Name="ExpiryText" Grid.Row="4" Grid.Column="1" Margin="0,4" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Обновлена:" Margin="0,4,8,4" />
                    <TextBlock x:Name="UpdatedText" Grid.Row="5" Grid.Column="1" Margin="0,4" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Автообновление:" Margin="0,4,8,4" />
                    <TextBlock x:Name="IntervalText" Grid.Row="6" Grid.Column="1" Margin="0,4" />
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Состояние:" Margin="0,4,8,4" />
                    <TextBlock x:Name="StateText" Grid.Row="7" Grid.Column="1"
                               TextWrapping="Wrap" Margin="0,4" />
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Поддержка:" Margin="0,4,8,4" />
                    <TextBlock x:Name="SupportText" Grid.Row="8" Grid.Column="1"
                               TextWrapping="Wrap" Margin="0,4" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
